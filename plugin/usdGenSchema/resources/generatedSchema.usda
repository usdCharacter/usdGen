class UsdGenPomadeGroom "UsdGenPomadeGroom"
{
    rel proxyPrim (
        customData = {
            string userDocBrief = '''The proxyPrim relationship allows us to link a
        prim whose purpose is "render" to its (single target)
        purpose="proxy" prim.'''
        }
    )
    uniform token purpose = "default" (
        allowedTokens = ["default", "render", "proxy", "guide"]
        customData = {
            string userDocBrief = """Purpose is a classification of geometry into categories that 
        can each be independently included or excluded from traversals of prims 
        on a stage, such as rendering or bounding-box computation traversals."""
        }
    )
    rel usdGen:pomade:description (
        customData = {
            string userDocBrief = "The UsdGenDescription this groom feeds: the committer fills in its GuideInterpolate operator."
        }
        doc = "The UsdGenDescription this groom feeds: the committer fills in its GuideInterpolate operator. Expression evaluation: groom (once per operator)."
    )
    rel usdGen:pomade:scalp (
        customData = {
            string userDocBrief = "The growth mesh this groom is bound to: a Mesh, or a face GeomSubset of one."
        }
        doc = "The growth mesh this groom is bound to: a Mesh, or a face GeomSubset of one. A subset limits picking, placement, region fill and the uncovered-face count to its faces, while face ids, the usdGen:pomadeRegion primvar and UsdGenRestAPI stay on the parent Mesh; the Output description's usdGen:surface names the subset too. Expression evaluation: groom (once per operator)."
    )
    token usdGen:pomade:version = "1" (
        customData = {
            string userDocBrief = "Committer format version of this groom."
        }
        doc = "Committer format version of this groom. Expression evaluation: groom (once per operator)."
    )
    token visibility = "inherited" (
        allowedTokens = ["inherited", "invisible"]
        customData = {
            string userDocBrief = '''Visibility is meant to be the simplest form of "pruning" 
        visibility that is supported by most DCC apps.'''
        }
    )
    uniform token[] xformOpOrder (
        customData = {
            string userDocBrief = """Encodes the sequence of transformation operations in the
        order in which they should be pushed onto a transform stack while
        visiting a UsdStage's prims in a graph traversal that will effect
        the desired positioning for this prim and its descendant prims."""
        }
    )
}

