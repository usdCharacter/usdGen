            string userDocBrief = "Mute for this operator."
        }
        doc = "Mute for this operator. A disabled styler or deformer passes its upstream through unchanged; a disabled generator (Scatter, Grow, CurveSource, ReferenceSource) produces an empty curve set, so the description publishes no curves. Expression evaluation: groom (once per operator)."
    )
    rel usdGen:guides (
        customData = {
            string userDocBrief = "The guide curves: one BasisCurves prim whose curves are the sparse guides."
        }
        doc = "The guide curves: one BasisCurves prim whose curves are the sparse guides. Each input root grows a strand of usdGen:cvCount CVs by blending the root-local shapes of its nearest guides."
    )
    float usdGen:influenceDecay = 2 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Falloff exponent: a guide at distance d weighs (1 - d / influenceRadius)^influenceDecay before normalisation."
        }
        doc = "Falloff exponent: a guide at distance d weighs (1 - d / influenceRadius)^influenceDecay before normalisation. 0 weighs every guide in reach equally. Must be finite and >= 0. Expression evaluation: groom (once per operator)."
    )
    float usdGen:influenceRadius = 4 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Search radius around a strand root, in rest scene units; a guide root farther away does not contribute."
        }
        doc = "Search radius around a strand root, in rest scene units; a guide root farther away does not contribute. A strand with no guide in reach follows the nearest guide of its region. Must be finite and > 0. Expression evaluation: groom (once per operator)."
    )
    float usdGen:maxGuideAngle = 90 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Largest angle, in degrees, between a strand's root normal and a guide's root normal for the guide to contribute, in [0, 180]."
        }
        doc = "Largest angle, in degrees, between a strand's root normal and a guide's root normal for the guide to contribute, in [0, 180]. Keeps guides on one side of a thin surface off the other. Expression evaluation: groom (once per operator)."
    )
    int usdGen:maxGuides = 3 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Most guides blended into one strand, in [1, 8]."
        }
        doc = "Most guides blended into one strand, in [1, 8]. The heaviest three are published per strand as guideIndex/guideWeight. Expression evaluation: groom (once per operator)."
    )
    float usdGen:part:amount = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "How strongly hair moves away from the parting lines, in [0, 1]; 0 disables parting."
        }
        doc = "How strongly hair moves away from the parting lines, in [0, 1]; 0 disables parting. Expression evaluation: groom (once per operator)."
    )
    float usdGen:part:angle = 80 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "How steeply hair lifts off the parting line, in degrees [0, 89]."
        }
        doc = "How steeply hair lifts off the parting line, in degrees [0, 89]. Expression evaluation: groom (once per operator)."
    )
    int[] usdGen:part:counts = [] (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Points per parting curve."
        }
        doc = "Points per parting curve. Expression evaluation: groom (once per operator)."
    )
    float usdGen:part:distance = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "How far along the strand the parting lasts, in [0, 1] (1 rotates the whole strand rigidly)."
        }
        doc = "How far along the strand the parting lasts, in [0, 1] (1 rotates the whole strand rigidly). Expression evaluation: groom (once per operator)."
    )
    normal3f[] usdGen:part:normals = [] (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Optional surface normal per parting point."
        }
        doc = "Optional surface normal per parting point. Expression evaluation: groom (once per operator)."
    )
    point3f[] usdGen:part:points = [] (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Parting curve points (scene units), concatenated; usdGen:part:counts splits them into curves."
        }
        doc = "Parting curve points (scene units), concatenated; usdGen:part:counts splits them into curves. Expression evaluation: groom (once per operator)."
    )
    float usdGen:part:radius = 0.5 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Width of the parting effect as a fraction of the parting curve's length, in [0, 1]."
        }
        doc = "Width of the parting effect as a fraction of the parting curve's length, in [0, 1]. Expression evaluation: groom (once per operator)."
    )
    float usdGen:randomizeGuide = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Per strand, per guide random reduction of the guide weights, in [0, 1]; breaks up the blend and, with useUniqueGuide, varies which guide a strand copies."
        }
        doc = "Per strand, per guide random reduction of the guide weights, in [0, 1]; breaks up the blend and, with useUniqueGuide, varies which guide a strand copies. Keyed by (usdGen:seed, curve id, guide). Expression evaluation: groom (once per operator)."
    )
    float usdGen:region = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
            string userDocBrief = "Region id per strand."
        }
        doc = "Region id per strand. A guide only shapes strands of its own region, and a guide's region is the value at its root (read from the strand rooted nearest it). Connect a UsdGenExpression to part the groom: a ptex(\"<map>\") region map, or a voronoi over the guide roots such as geoSampler(\"guideCurves\", \"$index\"). Values that differ by less than 1/1024 are the same region. Unconnected, every strand is in one region. Expression evaluation: primitive (once per curve root)."
    )
    float usdGen:regionCrossover = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Weight scale for guides of another region, in [0, 1]."
        }
        doc = "Weight scale for guides of another region, in [0, 1]. 0 keeps region borders hard (parting lines); larger values let neighbouring regions' guides soften the border. Expression evaluation: groom (once per operator)."
    )
    uniform int usdGen:seed = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Randomisation seed for this operator."
        }
        doc = "Randomisation seed for this operator. Every per-curve draw is keyed by (seed, curveId, salt), so the same seed reproduces the same groom exactly. Expression evaluation: groom (once per operator)."
    )
    float usdGen:tightness = 3 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Gaussian weighting exponent, clamped to [0.25, 8]; higher follows the nearest guide more closely."
        }
        doc = "Gaussian weighting exponent, clamped to [0.25, 8]; higher follows the nearest guide more closely. Expression evaluation: groom (once per operator)."
    )
    bool usdGen:useUniqueGuide = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Each strand copies its single heaviest guide instead of blending several."
        }
        doc = "Each strand copies its single heaviest guide instead of blending several. Expression evaluation: groom (once per operator)."
    )
    uniform token usdGen:weighting = "falloff" (
        allowedTokens = ["falloff", "nearest", "inverseDistance", "gaussian"]
        customData = {
            string userDocBrief = "Guide weighting: falloff ((1 - d/R)^decay over maxGuides within influenceRadius), nearest (the nearest guide's shape translated to the root), inverseDistance (the 3 nearest guides, weight 1/d), gaussian (a Gaussian kernel over all guides with sigma from the guide-root spacing, sharpened by usdGen:tightness)."
        }
        doc = "Guide weighting: falloff ((1 - d/R)^decay over maxGuides within influenceRadius), nearest (the nearest guide's shape translated to the root), inverseDistance (the 3 nearest guides, weight 1/d), gaussian (a Gaussian kernel over all guides with sigma from the guide-root spacing, sharpened by usdGen:tightness). Expression evaluation: groom (once per operator)."
    )
}

class UsdGenReferenceSource "UsdGenReferenceSource"
