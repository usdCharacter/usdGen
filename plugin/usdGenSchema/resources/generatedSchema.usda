class UsdGenDeform "UsdGenDeform"
{
    bool usdGen:enabled = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Mute for this operator."
        }
        doc = "Mute for this operator. A disabled styler or deformer passes its upstream through unchanged; a disabled generator (Scatter, Grow, CurveSource, ReferenceSource) produces an empty curve set, so the description publishes no curves. Expression evaluation: groom (once per operator)."
    )
    int[] usdGen:guideRegions = [] (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Region ID for each center curve in the usdGen:guides target's curve order."
        }
        doc = "Region ID for each center curve in the usdGen:guides target's curve order. Required with regionMap; one unique nonnegative integer per curve. Used only by curveWrap."
    )
    rel usdGen:guides (
        customData = {
            string userDocBrief = "Animated curves that drive the deformation on the CPU lane: one BasisCurves prim with UsdGenCurveAPI applied."
        }
        doc = "Animated curves that drive the deformation on the CPU lane: one BasisCurves prim with UsdGenCurveAPI applied. Each driver CV is an RBF sample bound at its rest position (primvars:rest, else its Default-time position) and moved to its current position, and every incoming CV moves by the resulting smooth field, which passes through the driver CVs and reproduces any affine motion of them exactly. Animate the curves' points; the drivers must span 3D (not all in one plane). Unset, the RBF samples the bound surface on CPU or CUDA. CPU surface input requires UsdGenRestAPI and Default-time rest points. Incoming CVs must be in surface rest-local coordinates. Posed surface samples are transformed into current groom space, supporting a groom outside the animated surface hierarchy; shared ancestor motion is applied once during publication. Set lockRoots=false to carry roots with the skin. Expression evaluation: groom (once per operator)."
    )
    bool usdGen:lockRoots = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "True keeps every root where it arrives: the whole strand is shifted back by the field's displacement at its root, so the deformation only bends the strand above it."
        }
        doc = "True keeps every root where it arrives: the whole strand is shifted back by the field's displacement at its root, so the deformation only bends the strand above it. Expression evaluation: groom (once per operator)."
    )
    float usdGen:mask = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
            string userDocBrief = "Per-operator effect weight in [0, 1]."
        }
        doc = "Per-operator effect weight in [0, 1]. 1 applies the operator fully, 0 leaves the upstream curves bit-for-bit untouched. Author a literal for a uniform weight, or connect this attribute to a UsdGenExpression (to the prim, or to its outputs:result) to drive it per curve. Expression evaluation: primitive (once per curve root); override the attribute's customData usdGen:evaluation to \"point\" for a per-CV weight (use $t for the root-to-tip parameter)."
    )
    uniform token usdGen:mode = "" (
        allowedTokens = ["", "curveWrap"]
        customData = {
            string userDocBrief = "Empty selects the existing RBF deformer."
        }
        doc = "Empty selects the existing RBF deformer. curveWrap is CPU-only and uses one open center curve, or multiple center curves partitioned by regionMap and guideRegions, with matching rest/current CV topology. Each incoming CV binds to the nearest rest segment of its assigned center curve and keeps its segment fraction and local offset; rotation-minimizing frames preserve thickness. Straight and planar rest curves are supported. Animate driver points; roll about the tangent uses minimum twist. Guides and incoming groom must share a rest coordinate domain. rbfSamples is unused in curveWrap mode."
    )
    int usdGen:rbfSamples = 100 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Most RBF samples used: taken on the bound surface, or, with usdGen:guides, farthest-point sampled from the driver CVs."
        }
        doc = "Most RBF samples used: taken on the bound surface, or, with usdGen:guides, farthest-point sampled from the driver CVs. Higher values track the drivers more closely at a higher per-frame cost. At least 4. Expression evaluation: groom (once per operator)."
    )
    rel usdGen:regionMap (
        customData = {
            string userDocBrief = "Optional categorical UsdGenPtexMap for curveWrap."
        }
        doc = "Optional categorical UsdGenPtexMap for curveWrap. Sampled at each strand's rest root, its raw integer ID selects the center curve labelled by guideRegions. Required for multiple centers. The whole strand follows that center without cross-region blending or nearest-driver fallback. Requires filter=nearest and blur=0; map:firstChannel selects the ID channel. Map scale/offset/clamp are not applied. Invalid or unmatched IDs fail the cook."
    )
    uniform int usdGen:seed = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Randomisation seed for this operator."
        }
        doc = "Randomisation seed for this operator. Every per-curve draw is keyed by (seed, curveId, salt), so the same seed reproduces the same groom exactly. Expression evaluation: groom (once per operator)."
    )
}

class UsdGenCollide "UsdGenCollide"
{
    float usdGen:clearance:root = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "resolveType relax: clearance kept at the root (scene units), blended to usdGen:clearance:tip along the strand."
        }
        doc = "resolveType relax: clearance kept at the root (scene units), blended to usdGen:clearance:tip along the strand. Expression evaluation: groom (once per operator)."
    )
    float usdGen:clearance:tip = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "resolveType relax: clearance kept at the tip (scene units)."
        }
        doc = "resolveType relax: clearance kept at the tip (scene units). Expression evaluation: groom (once per operator)."
    )
    rel usdGen:colliders (
        customData = {
            string userDocBrief = "Collider Meshes or face GeomSubsets for the push-out solve, appended after the bound surface, which always collides too."
        }
        doc = "Collider Meshes or face GeomSubsets for the push-out solve, appended after the bound surface, which always collides too. A GeomSubset collides with just the parent-mesh faces it names; an empty one is an error. Each of the iterations sweeps moves penetrating CVs out along the closest-point direction, keeping an offset gap and scaling the correction by pushAmount. Expression evaluation: groom (once per operator)."
    )
    bool usdGen:enabled = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Mute for this operator."
        }
        doc = "Mute for this operator. A disabled styler or deformer passes its upstream through unchanged; a disabled generator (Scatter, Grow, CurveSource, ReferenceSource) produces an empty curve set, so the description publishes no curves. Expression evaluation: groom (once per operator)."
    )
    int usdGen:iterations = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Number of push-out sweeps over each strand."
        }
        doc = "Number of push-out sweeps over each strand. At least 1. Expression evaluation: groom (once per operator)."
    )
    float usdGen:mask = 1 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
            string userDocBrief = "Per-operator effect weight in [0, 1]."
        }
        doc = "Per-operator effect weight in [0, 1]. 1 applies the operator fully, 0 leaves the upstream curves bit-for-bit untouched. Author a literal for a uniform weight, or connect this attribute to a UsdGenExpression (to the prim, or to its outputs:result) to drive it per curve. Expression evaluation: primitive (once per curve root); override the attribute's customData usdGen:evaluation to \"point\" for a per-CV weight (use $t for the root-to-tip parameter)."
    )
    float usdGen:offset = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
            string userDocBrief = "Rest gap kept between CVs and collider surfaces after the push-out solve."
        }
        doc = "Rest gap kept between CVs and collider surfaces after the push-out solve. Expression evaluation: primitive (once per curve root)."
    )
    float usdGen:pushAmount = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "primitive"
            }
            string userDocBrief = "Fraction of the push-out correction applied per sweep; 1 applies the full separation."
        }
        doc = "Fraction of the push-out correction applied per sweep; 1 applies the full separation. Expression evaluation: primitive (once per curve root)."
    )
    int usdGen:relax:iterations = 24 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "resolveType relax: smoothing/relaxation sweeps."
        }
        doc = "resolveType relax: smoothing/relaxation sweeps. Expression evaluation: groom (once per operator)."
    )
    uniform token usdGen:resolveType = "flexible" (
        allowedTokens = ["flexible", "stiff", "relax"]
        customData = {
            string userDocBrief = 'How the push-out moves the strand: "flexible" corrects each CV independently, "stiff" hinges the strand about the last clean CV.'
        }
        doc = 'How the push-out moves the strand: "flexible" corrects each CV independently, "stiff" hinges the strand about the last clean CV. Expression evaluation: groom (once per operator).'
    )
    uniform int usdGen:seed = 0 (
        customData = {
            dictionary usdGen = {
                string evaluation = "groom"
            }
            string userDocBrief = "Randomisation seed for this operator."
        }
        doc = "Randomisation seed for this operator. Every per-curve draw is keyed by (seed, curveId, salt), so the same seed reproduces the same groom exactly. Expression evaluation: groom (once per operator)."
    )
}

