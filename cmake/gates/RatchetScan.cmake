# RatchetScan.cmake: count regex hits per source file and hold each count at
# or below a checked-in baseline. A gate that only ratchets down: new hits
# fail, removed hits pass and print the tighter baseline to commit.
#
# Inputs:
#   SOURCE_DIR  repo root
#   NAME        gate name for messages
#   DIRS        dirs to scan (relative to SOURCE_DIR), separated by , or ;
#   PATTERN     regex; one hit per matching line
#   BASELINE    baseline file: "<relative path> <count>" per line, # comments
#   WRITE       optional; ON rewrites BASELINE from the current tree

foreach(_v SOURCE_DIR NAME DIRS PATTERN BASELINE)
    if(NOT DEFINED ${_v} OR "${${_v}}" STREQUAL "")
        message(FATAL_ERROR "RatchetScan: ${_v} is required")
    endif()
endforeach()

set(_allowed "")
if(EXISTS "${BASELINE}")
    file(STRINGS "${BASELINE}" _base REGEX "^[^#]")
    foreach(_line IN LISTS _base)
        string(REGEX MATCH "^([^ ]+) ([0-9]+)$" _m "${_line}")
        if(_m)
            set(_allowed_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
            list(APPEND _allowed "${CMAKE_MATCH_1}")
        endif()
    endforeach()
endif()

set(_scanned 0)
set(_total 0)
set(_fail 0)
set(_shrunk 0)
set(_report "")
set(_seen "")
string(REPLACE "," ";" DIRS "${DIRS}")
foreach(_dir IN LISTS DIRS)
    if(NOT EXISTS "${SOURCE_DIR}/${_dir}")
        continue()
    endif()
    file(GLOB_RECURSE _files
        "${SOURCE_DIR}/${_dir}/*.h" "${SOURCE_DIR}/${_dir}/*.hpp"
        "${SOURCE_DIR}/${_dir}/*.cpp" "${SOURCE_DIR}/${_dir}/*.cu"
        "${SOURCE_DIR}/${_dir}/*.cuh" "${SOURCE_DIR}/${_dir}/*.inl")
    list(SORT _files)
    foreach(_f IN LISTS _files)
        math(EXPR _scanned "${_scanned} + 1")
        file(RELATIVE_PATH _rel "${SOURCE_DIR}" "${_f}")
        file(STRINGS "${_f}" _hits REGEX "${PATTERN}")
        list(LENGTH _hits _n)
        if(_n EQUAL 0)
            if(DEFINED _allowed_${_rel})
                set(_shrunk 1)
            endif()
            continue()
        endif()
        list(APPEND _seen "${_rel}")
        math(EXPR _total "${_total} + ${_n}")
        string(APPEND _report "${_rel} ${_n}\n")
        if(NOT DEFINED _allowed_${_rel})
            set(_fail 1)
            message(SEND_ERROR "${NAME}: new hits in ${_rel} (${_n}):")
            foreach(_h IN LISTS _hits)
                string(STRIP "${_h}" _h)
                message(SEND_ERROR "    ${_h}")
            endforeach()
        elseif(_n GREATER _allowed_${_rel})
            set(_fail 1)
            message(SEND_ERROR "${NAME}: ${_rel} has ${_n} hits, baseline ${_allowed_${_rel}}")
        elseif(_n LESS _allowed_${_rel})
            set(_shrunk 1)
        endif()
    endforeach()
endforeach()

if(_scanned EQUAL 0)
    message(FATAL_ERROR "${NAME}: scanned zero files (false pass)")
endif()

if(WRITE)
    file(WRITE "${BASELINE}"
        "# ${NAME} baseline: <path> <hits>. Generated by RatchetScan.cmake WRITE=ON.\n"
        "# Counts may only go down. The target is an empty file.\n${_report}")
    message(STATUS "${NAME}: baseline written (${_total} hits)")
    return()
endif()
if(_fail)
    message(FATAL_ERROR "${NAME}: FAILED (${_total} hits in ${_scanned} files)")
endif()
if(_shrunk)
    message(STATUS "${NAME}: hits went down; tighten the baseline with WRITE=ON")
endif()
message(STATUS "${NAME}: passed (${_total} hits in ${_scanned} files, target 0)")
