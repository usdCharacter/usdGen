# usdGenConfig.cmake.in — CMake package config for downstream consumers
@PACKAGE_INIT@

# Resolve package-relative paths first (sol S-5/X-4).
set_and_check(usdGen_PLUGIN_DIR "@PACKAGE_USDGEN_INSTALL_PLUGINDIR@")
set_and_check(usdGen_LIBRARY_DIR "@PACKAGE_USDGEN_INSTALL_LIBDIR@")

# Plugin locations, so a consuming build can compose PXR_PLUGINPATH_NAME
# without hardcoding the layout.
set(usdGen_PLUGINPATHS
    "${usdGen_PLUGIN_DIR}/usdGenSchema/resources"
    "${usdGen_PLUGIN_DIR}/usdGenImaging/resources")

# 12.5: usdGen::usdGen is the only exported target. Its interface is the
# api/ headers and the usdGen library; no OpenUSD, TBB, OpenGL or Vulkan
# dependency, so nothing is found here.
include("${CMAKE_CURRENT_LIST_DIR}/usdGenTargets.cmake")
