// deformEvaluateCached.comp — cached-R evaluation for the deform R cache:
// deformEvaluate.comp with the radius-cubed inner loop carried by the
// cache instead of recomputed. Every other expression (normalizer,
// polynomial, accumulate, output, flag) is deformEvaluate.comp's text
// verbatim, so a verified cache evaluates bitwise what the direct shader
// did. Covers CVs [0,count), where count is the active prefix length
// (min(points,P)); points past the cached prefix run through the direct
// shader with a base offset.
//
// The descriptor numbering matches deformEvaluate.comp exactly (binding
// 2 carries R instead of the samples), so this pipeline reuses the eval
// descriptor-set layout; only the UBO layout differs (the R row stride
// replaces the second counts word and the tail pad).
//
// ABI — descriptors:
//   0 cvs      float[3*points] RO  (input CVs)
//   1 warped   float[3*points]     OUT
//   2 r        double[n*P]    RO   (cached radius-cubed rows, P-wide)
//   3 coef     double[3*m]    RO   (column-major m x 3 coefficients)
//   4 UBO      CachedUbo (64 bytes)
//   5 evalFlag int[1]         OUT  (atomicOr, 0 == clean)
//
// Dispatch: local_size_x=128, groups=ceil(count/128).

#version 460
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Cvs     { float cvs[]; };
layout(std430, binding = 1) buffer Warped            { float warped[]; };
layout(std430, binding = 2) readonly buffer RCache   { double rcache[]; };
layout(std430, binding = 3) readonly buffer Coef     { double coef[]; };
layout(std430, binding = 5) buffer EvalFlag          { int evalFlag; };

layout(std140, binding = 4) uniform Params {
    ivec4 nmcs;     // x = n (samples), y = m (n+4), z = count, w = P (R stride)
    double cx;
    double cy;
    double cz;
    double invScale;
    double scale;
    double _pad;
} params;

#define P3(a, i) vec3((a)[3u*(i)], (a)[3u*(i)+1u], (a)[3u*(i)+2u])

bool Finite(float v)   { return !(isinf(v) || isnan(v)); }
bool FiniteD(double v) { return !(isinf(v) || isnan(v)); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(params.nmcs.z)) return;
    int n = params.nmcs.x;
    int m = params.nmcs.y;
    uint stride = uint(params.nmcs.w);

    vec3 p = P3(cvs, i);
    if (!Finite(p.x) || !Finite(p.y) || !Finite(p.z)) { atomicOr(evalFlag, 1); return; }

    double x = (double(p.x) - params.cx) * params.invScale;
    double y = (double(p.y) - params.cy) * params.invScale;
    double z = (double(p.z) - params.cz) * params.invScale;

    // Polynomial part (last 4 coefficients of each column; coef[n..n+3] for x).
    double ox = x + coef[n]     + coef[n+1]*x + coef[n+2]*y + coef[n+3]*z;
    double oy = y + coef[m+n]   + coef[m+n+1]*x + coef[m+n+2]*y + coef[m+n+3]*z;
    double oz = z + coef[2*m+n] + coef[2*m+n+1]*x + coef[2*m+n+2]*y + coef[2*m+n+3]*z;

    for (int j = 0; j < n; ++j) {
        double r = rcache[stride * uint(j) + i];
        ox += coef[j] * r;
        oy += coef[m + j] * r;
        oz += coef[2*m + j] * r;
    }

    double oxw = ox * params.scale + params.cx;
    double oyw = oy * params.scale + params.cy;
    double ozw = oz * params.scale + params.cz;
    if (!FiniteD(oxw) || !FiniteD(oyw) || !FiniteD(ozw)) { atomicOr(evalFlag, 1); return; }

    warped[3u*i]     = float(oxw);
    warped[3u*i + 1u] = float(oyw);
    warped[3u*i + 2u] = float(ozw);
}
