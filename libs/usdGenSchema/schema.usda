        doc = """Authored GuideProximityMap control "decay". Declared for the frozen v1-v3 vocabulary; no kernel implements GuideProximityMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# ---------------------------------------------------------------------------
# API schemas (02-schema.md §2.13–§2.16), all single-apply
# ---------------------------------------------------------------------------

# UsdGenLookAPI — single-apply on UsdGenDescription (02 §2.14). Carries only
# what the displayColor bake needs plus the parameters that must agree
# between bake and shader (07 §1.1).
class "UsdGenLookAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "LookAPI"
        token apiSchemaType = "singleApply"
    }
)
{
    color3f usdGen:look:rootColor = (0.035, 0.018, 0.008) (
        doc = """Display colour at the strand root. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    color3f usdGen:look:tipColor = (0.21, 0.115, 0.045) (
        doc = """Display colour at the strand tip. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float[] usdGen:look:colorRamp:positions = [] (
        doc = """Root-to-tip positions, in [0, 1], of the colour ramp stops. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    color3f[] usdGen:look:colorRamp:colors = [] (
        doc = """Colours at the usdGen:look:colorRamp:positions stops. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:look:colorRamp:interpolation = "catmullRom" (
        doc = """Interpolation between colour ramp stops. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
    float usdGen:look:rampExponent = 1.0 (
        doc = """Exponent applied to the ramp parameter before lookup. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:look:colorMapMode = "bake" (
        doc = """How usdGen:look:colorMap combines with the ramp colour. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["bake", "shader"]
    )
    uniform token usdGen:look:bakeMode = "perCurve" (
        doc = """Whether and how the resolved colour is baked into a primvar. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["perCurve", "perCV"]
    )
    rel usdGen:look:colorMap (
        doc = """Map supplying a per-root colour. Expression evaluation: groom (once per operator)."""
    )
    float usdGen:look:hueJitter = 0.0 (
        doc = """Per-curve hue variation, in [0, 1]. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:look:valueJitter = 0.0 (
        doc = """Per-curve value variation, in [0, 1]. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    uniform int usdGen:look:jitterSeed = 0 (
        doc = """Seed for the per-curve hue/value jitter draws. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    uniform token usdGen:look:bakeTarget = "displayColor" (
        doc = """Which published prim set receives the baked colour. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["displayColor", "primvar", "none"]
    )
    token usdGen:look:bakePrimvar = "usdGen:albedo" (
        doc = """Name of the primvar the baked colour is written to. Expression evaluation: groom (once per operator)."""
    )
}

# UsdGenRestAPI — single-apply on a bound surface Mesh (02 §2.15). The
# RestAPI adapter publishes usdGen/rest/{points, faceVertexCounts,
# faceVertexIndices, st} at UsdTimeCode::Default().
class "UsdGenRestAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "RestAPI"
        token apiSchemaType = "singleApply"
    }
)
{
    uniform token usdGen:rest:source = "default" (
        doc = """Where rest positions come from: "default" uses the default time sample, "primvar" the named primvar, "file" the referenced asset. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["default", "primvar", "asset"]
    )
    token usdGen:rest:primvar = "rest" (
        doc = """Name of the primvar holding rest positions when usdGen:rest:source is "primvar". Expression evaluation: groom (once per operator)."""
    )
    asset usdGen:rest:file = @@ (
        doc = """Asset holding rest positions when usdGen:rest:source is "file". Expression evaluation: groom (once per operator)."""
    )
}

# UsdGenCurveAPI — single-apply on every C3 curve prim (02 §2.16): guides,
# freezes, imports and sim caches. primvars: spelling is deliberate (02 §2.16).
class "UsdGenCurveAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "CurveAPI"
        token apiSchemaType = "singleApply"
    }
)
{
    token primvars:usdGen:role = "hair" (
        allowedTokens = ["hair", "guide"]
    )
    uint64[] primvars:usdGen:curveId = [] (
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    string primvars:usdGen:frozenEpoch = ""
    matrix4d[] primvars:usdGen:rootFrame = [] (
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:surfaceCage:ownerIds = [] (
        doc = """Owner tube id per surface-cage owner. Parallel to all owner payload arrays."""
    )
    float[] usdGen:surfaceCage:ownerDensities = [] (
        doc = """Base output density per surface-cage owner. Runtime applies CurveSource densityMultiplier."""
    )
    int[] usdGen:surfaceCage:ownerSeeds = [] (
        doc = """Deterministic output seed per surface-cage owner."""
    )
    int[] usdGen:surfaceCage:ownerCvCounts = [] (
        doc = """Common normalized rail CV count per surface-cage owner."""
    )
    float[] usdGen:surfaceCage:ownerEdgeBias = [] (
        doc = """Per-owner runtime edge-bias control; raw cage rails do not include it."""
    )
    float2[] usdGen:surfaceCage:ownerChartCentroids = [] (
        doc = """Per-owner chart centroids used only to normalize the runtime length profile."""
    )
    float[] usdGen:surfaceCage:ownerChartMeanRadii = [] (
        doc = """Positive per-owner chart mean radii used only to normalize the runtime length profile."""
    )
    int[] usdGen:surfaceCage:ownerLengthProfileOffsets = [] (
        doc = """Owner-indexed offsets into usdGen:surfaceCage:ownerLengthProfile; size ownerCount + 1."""
    )
    float2[] usdGen:surfaceCage:ownerLengthProfile = [] (
        doc = """Packed owner length-profile pairs (normalized radius, length multiplier)."""
    )
    int3[] usdGen:surfaceCage:triangles = [] (
        doc = """Sparse rail-index triples defining each surface-cage triangle."""
    )
    int[] usdGen:surfaceCage:triangleOwnerIndices = [] (
        doc = """Owner-array index per surface-cage triangle."""
    )
    float[] usdGen:surfaceCage:normalizedT = [] (
        doc = """Flattened per-point normalized longitudinal stations for the sparse rails. Values follow the BasisCurves point order and are strictly increasing within each rail; runtime interpolation never substitutes arc length or uniform CV indices."""
    )
    float2[] usdGen:surfaceCage:triangleRootCharts = [] (
        doc = """Three root chart coordinates per surface-cage triangle, in triangle index order."""
    )
}

# ---------------------------------------------------------------------------
# Pomade authoring (plan/17 section 2.2), P1. Authoring-side only: no usdGen
# kernel reads these prims; the PomadeCommitter writes them and the hydrate
# path reads them back. No dead knobs: every attribute below is read by
# hydrate.
# ---------------------------------------------------------------------------

# UsdGenPomadeGroom - Xformable container for one committed Pomade groom: the
# tube hierarchy, the scalp graph, the committed Guides, the RegionMap and the
# RegionExpr that feeds the linked description's GuideInterpolate.
class UsdGenPomadeGroom "UsdGenPomadeGroom" (
    inherits = </Xformable>
    customData = {
        string className = "PomadeGroom"
    }
)
{
    rel usdGen:pomade:scalp (
        doc = """The growth mesh this groom is bound to: a Mesh, or a face GeomSubset of one. A subset limits picking, placement, region fill and the uncovered-face count to its faces, while face ids, the usdGen:pomadeRegion primvar and UsdGenRestAPI stay on the parent Mesh; the Output description's usdGen:surface names the subset too. Expression evaluation: groom (once per operator)."""
    )
    rel usdGen:pomade:description (
        doc = """The UsdGenDescription this groom feeds: the committer fills in its GuideInterpolate operator. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:pomade:version = "1" (
        doc = """Committer format version of this groom. Expression evaluation: groom (once per operator)."""
    )
}

# UsdGenScalpGraph - one per groom: the shared planar graph authored on the
# scalp. Nodes are shared between neighbouring regions; regions are polygon
# loops over the shared node ids, so a welded boundary appears in both
# regions' loops. Written by Graph mode (P2); the P1 committer writes the
# empty graph shell so hydrate always finds the prim.
class UsdGenScalpGraph "UsdGenScalpGraph" (
    inherits = </Boundable>
    customData = {
        string className = "ScalpGraph"
    }
)
{
    int[] usdGen:pomade:nodeFaceIds = [] (
        doc = """Scalp face id per graph node; parallel to usdGen:pomade:nodeUVs. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2[] usdGen:pomade:nodeUVs = [] (
        doc = """Face UV per graph node; parallel to usdGen:pomade:nodeFaceIds. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int2[] usdGen:pomade:edges = [] (
        doc = """Node index pairs forming the graph edges. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:pomade:regionNodeCounts = [] (
        doc = """Node count per closed region; polygon-style region encoding. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:pomade:regionNodeIndices = [] (
        doc = """Shared node ids per region loop, regionNodeCounts at a time. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    color3f[] usdGen:pomade:regionColors = [] (
        doc = """Display colour per region. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int2[] usdGen:pomade:linkedRegions = [] (
        doc = """Region index pairs that share one interpolation id while staying distinct tubes. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:pomade:snapRadius = 0.01 (
        doc = """On-surface weld/snap distance in rest units. Must be finite and >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenTube - one clump volume: a center curve plus orthogonal planar
# cross-sections. Hierarchy is prim hierarchy: children are namespace children
# of their parent tube. L1 tubes carry absolute shape; deeper tubes carry
# deltas relative to the derived shape (P4); the P1 committer writes L1 only.
class UsdGenTube "UsdGenTube" (
    inherits = </Xformable>
    customData = {
        string className = "Tube"
    }
)
{
    int usdGen:pomade:regionId = 0 (
        doc = """Scalp-graph region this tube is rooted in (-1 = unrooted, the root-disc stream). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:level = 1 (
        doc = """Hierarchy level (L1/L2/L3...), derived from the prim depth and stored for tools. Must be >= 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    point3f[] usdGen:pomade:centerPoints = [] (
        doc = """Center curve control vertices in groom space. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float[] usdGen:pomade:sectionT = [] (
        doc = """Parametric position of each cross-section along the center curve. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:sectionCvCount = 8 (
        doc = """Ring control vertices per cross-section, in [3, 32]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2[] usdGen:pomade:sectionCvs = [] (
        doc = """Flattened cross-section ring CVs in the section plane, sectionCvCount per section. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:childIndex = -1 (
        doc = """Index within the parent's subdivision; -1 at L1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    point3f[] usdGen:pomade:centerDeltas = [] (
        doc = """Child center edits relative to the derived shape; empty at L1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2[] usdGen:pomade:sectionDeltas = [] (
        doc = """Child section edits relative to the derived shape; empty at L1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:subdivide:count = 4 (
        doc = """Child tubes per subdivision, in [2, 8]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:subdivide:seed = 0 (
        doc = """Seed for the subdivision split; children re-derive bit-exactly from (tubeId, seed). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    token usdGen:pomade:subdivide:splitMode = "kmeans" (
        doc = """How the parent root region is partitioned: "kmeans" splits by seeded k-means in the root frame, "edge" follows an artist-drawn splitting edge. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["kmeans", "edge"]
    )
    float usdGen:pomade:fill:density = 100.0 (
        doc = """Expected guides per unit of root-section area. Must be finite and >= 0. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:fill:cvCount = 8 (
        doc = """CVs per filled guide, in [2, 64]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float[] usdGen:pomade:fill:lengthProfile = [] (
        doc = """Length ramp knots in the usdGenMath ramp encoding; empty means uniform length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:pomade:fill:seed = 0 (
        doc = """Seed for root sampling and fill; guides regenerate bit-exactly from (tubeId, seed). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:pomade:fill:edgeBias = 0.0 (
        doc = """Radial root remap in [-1, 1]: +1 pushes roots toward the tube wall, -1 pulls them to the center, 0 is uniform. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:pomade:locked = false (
        doc = """True freezes this tube against all edits. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:pomade:lockParents = false (
        doc = """True stops child edits from refreshing ancestors bottom-up. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:pomade:lockChildren = false (
        doc = """True moves descendants rigidly with parent edits instead of re-deriving them. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenTubeHierarchyAPI - single-apply on a tube prim that is a transient or
# on-the-fly parent (P4). Applied per prim, never auto-applied.
class "UsdGenTubeHierarchyAPI" (
    inherits = </APISchemaBase>
    customData = {
        string className = "TubeHierarchyAPI"
        token apiSchemaType = "singleApply"
    }
)
{
    rel usdGen:pomade:members (
        doc = """Tubes this on-the-fly parent was built from. Expression evaluation: groom (once per operator)."""
    )
    bool usdGen:pomade:persistent = false (
        doc = """True keeps the on-the-fly parent as a persistent tube; false leaves it transient. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}
