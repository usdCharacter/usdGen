# UsdGenDeform — curves follow the surface (02 §2.8).
class UsdGenDeform "UsdGenDeform" (
    inherits = </UsdGenDeformer>
    customData = {
        string className = "Deform"
    }
)
{
    rel usdGen:regionMap (
        doc = """Optional categorical UsdGenPtexMap sampled at each strand's rest root. Raw integer IDs in map:firstChannel override usdGen:region and partition guide interpolation; filter must be nearest, blur zero, and regionCrossover zero. Each growth guide inherits the region of its nearest rest strand root. Missing regions fail instead of borrowing another region's guides. Map scale/offset/clamp are not applied to IDs."""
    )
    uniform token usdGen:mode = "" (
        allowedTokens = ["", "curveWrap"]
        doc = """Empty selects the existing RBF deformer. curveWrap is CPU-only and uses one open center curve, or multiple center curves partitioned by regionMap and guideRegions, with matching rest/current CV topology. Each incoming CV binds to the nearest rest segment of its assigned center curve and keeps its segment fraction and local offset; rotation-minimizing frames preserve thickness. Straight and planar rest curves are supported. Animate driver points; roll about the tangent uses minimum twist. Guides and incoming groom must share a rest coordinate domain. rbfSamples is unused in curveWrap mode."""
    )
    rel usdGen:regionMap (
        doc = """Optional categorical UsdGenPtexMap for curveWrap. Sampled at each strand's rest root, its raw integer ID selects the center curve labelled by guideRegions. Required for multiple centers. The whole strand follows that center without cross-region blending or nearest-driver fallback. Requires filter=nearest and blur=0; map:firstChannel selects the ID channel. Map scale/offset/clamp are not applied. Invalid or unmatched IDs fail the cook."""
    )
    int[] usdGen:guideRegions = [] (
        doc = """Region ID for each center curve in the usdGen:guides target's curve order. Required with regionMap; one unique nonnegative integer per curve. Used only by curveWrap."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    rel usdGen:guides (
        doc = """Animated curves that drive the deformation on the CPU lane: one BasisCurves prim with UsdGenCurveAPI applied. Each driver CV is an RBF sample bound at its rest position (primvars:rest, else its Default-time position) and moved to its current position, and every incoming CV moves by the resulting smooth field, which passes through the driver CVs and reproduces any affine motion of them exactly. Animate the curves' points; the drivers must span 3D (not all in one plane). Unset, the RBF samples the bound surface on CPU or CUDA. CPU surface input requires UsdGenRestAPI and Default-time rest points. Incoming CVs must be in surface rest-local coordinates. Posed surface samples are transformed into current groom space, supporting a groom outside the animated surface hierarchy; shared ancestor motion is applied once during publication. Set lockRoots=false to carry roots with the skin. Expression evaluation: groom (once per operator)."""
    )
    bool usdGen:lockRoots = true (
        doc = """True keeps every root where it arrives: the whole strand is shifted back by the field's displacement at its root, so the deformation only bends the strand above it. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:rbfSamples = 100 (
        doc = """Most RBF samples used: taken on the bound surface, or, with usdGen:guides, farthest-point sampled from the driver CVs. Higher values track the drivers more closely at a higher per-frame cost. At least 4. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenCollide (v3) — 02 §2.8; defaults for offset/pushAmount/iterations
# and the resolveType token set are adopted from 04-operators.md §4
# (recorded in C1.md §7).
class UsdGenCollide "UsdGenCollide" (
    inherits = </UsdGenDeformer>
    customData = {
        string className = "Collide"
    }
)
{
    rel usdGen:colliders (
        doc = """Collider Meshes or face GeomSubsets for the push-out solve, appended after the bound surface, which always collides too. A GeomSubset collides with just the parent-mesh faces it names; an empty one is an error. Each of the iterations sweeps moves penetrating CVs out along the closest-point direction, keeping an offset gap and scaling the correction by pushAmount. Expression evaluation: groom (once per operator)."""
    )
    float usdGen:offset = 0.0 (
        doc = """Rest gap kept between CVs and collider surfaces after the push-out solve. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:pushAmount = 0.0 (
        doc = """Fraction of the push-out correction applied per sweep; 1 applies the full separation. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    int usdGen:iterations = 1 (
        doc = """Number of push-out sweeps over each strand. At least 1. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:resolveType = "flexible" (
        doc = """How the push-out moves the strand: "flexible" corrects each CV independently, "stiff" hinges the strand about the last clean CV. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["flexible", "stiff", "relax"]
    )
    float usdGen:clearance:root = 0.0 (
        doc = """resolveType relax: clearance kept at the root (scene units), blended to usdGen:clearance:tip along the strand. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:clearance:tip = 0.0 (
        doc = """resolveType relax: clearance kept at the tip (scene units). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:relax:iterations = 24 (
        doc = """resolveType relax: smoothing/relaxation sweeps. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# ---------------------------------------------------------------------------
# Whole-strand stylers and the card generator (groom import)
# ---------------------------------------------------------------------------

# UsdGenBraid — three-lane braid woven around each guide; emits clumpId_0
# (3 * guide + lane) and the per-CV braidKnotMask.
class UsdGenBraid "UsdGenBraid" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Braid"
    }
)
{
    rel usdGen:guides (
        doc = """Guide curves the braids are woven around (one braid per guide)."""
    )
    float usdGen:braid:frequency = 8.0 (
        doc = """Number of crossings along the braid per reference length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:width = 1.0 (
        doc = """Braid width relative to the reference length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:flatness = 0.55 (
        doc = """Flattens the braided strands, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:knotTightness = 0.5 (
        doc = """How tightly the braid is woven, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:fadeIn = 0.1 (
        doc = """Eases the weave in from the root, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:fadeOut = 0.1 (
        doc = """Eases the weave out toward the tip, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:rootSpread = 0.0 (
        doc = """How far the strands spread apart at the root. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:tipSpread = 0.0 (
        doc = """How far the strands spread apart at the tip. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:tailLength = 0.0 (
        doc = """Loose, unbraided share of the length at the end, in [0, 0.9]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:tailRelax = 0.5 (
        doc = """How loosely the tail hangs, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:tailCinch = 0.6 (
        doc = """Tightens the tail where the braid ends, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:referenceLength = 0.0 (
        doc = """Length that braid width and frequency are relative to; 0 uses the diagonal of the bound surface's rest bounds. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:root = 0.0 (
        doc = """Braid pull at the root (quadratic Bezier root/mid/tip profile: control points (0, root), (midShift, mid), (1, tip); mid is a control value, midShift its position along the strand). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:mid = 0.5 (
        doc = """Braid pull middle control value of the Bezier profile. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:midShift = 0.5 (
        doc = """Position of the braid pull mid control along the strand, clamped to [0.1, 0.9]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:tip = 1.0 (
        doc = """Braid pull at the tip. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:amount = 1.0 (
        doc = """Overall braid pull, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:flyaway:fraction = 0.0 (
        doc = """Share of strands that escape the braid, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:braid:flyaway:amount = 0.0 (
        doc = """Multiplier on a flyaway strand's braid weight, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:braid:knotMask = false (
        doc = """Emits braidKnotMask (1 - knot) so Frizz can keep the crossings clean. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenTwist — rotates strands about the mean curve of their guide group or
# clump by a root/mid/tip angle profile.
class UsdGenTwist "UsdGenTwist" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Twist"
    }
)
{
    float usdGen:twist:amount = 1.0 (
        doc = """Multiplies the whole twist (2 turns a 180 degree twist into a full turn). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:twist:root = 0.0 (
        doc = """Twist angle in degrees at the root (quadratic Bezier root/mid/tip profile: control points (0, root), (midShift, mid), (1, tip); mid is a control value, midShift its position along the strand). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:twist:mid = 0.0 (
        doc = """Twist angle in degrees middle control value of the Bezier profile. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:twist:midShift = 0.5 (
        doc = """Position of the twist angle in degrees mid control along the strand, clamped to [0.1, 0.9]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:twist:tip = 0.0 (
        doc = """Twist angle in degrees at the tip. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:twist:noise = 0.0 (
        doc = """Per-strand variation of the twist along the length, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:twist:useClumpIds = false (
        doc = """Each clump twists around its own centre (clumpId_0) instead of around its guide group. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:twist:resnapRoot = true (
        doc = """Snaps a root that the twist moved back onto the bound surface with a smooth falloff. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenTrim — cuts strands at their first crossing with blade ribbons that
# stand on the trim curves.
class UsdGenTrim "UsdGenTrim" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Trim"
    }
)
{
    rel usdGen:trim:curves (
        doc = """Trim curves drawn on the surface; each carries a blade of height usdGen:trim:distance. Optional per-curve overrides: primvars:usdGen:plane:trimAngle / trimInvert / trimDistance (uniform)."""
    )
    float usdGen:trim:angle = 0.0 (
        doc = """Tilts the cutting blade about the curve tangent, in degrees [0, 89]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:trim:invert = false (
        doc = """Tilts the blade the other way. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:trim:distance = 0.1 (
        doc = """Blade height off the surface (scene units). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:trim:normalSearch = 0.08 (
        doc = """Radius (scene units) searched on the bound surface for the blade normal at each trim point. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenFrizz — two-axis wave plus value-noise kinks in a transport frame,
# with a root/mid/tip profile; amplitude relative to the strand length.
class UsdGenFrizz "UsdGenFrizz" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Frizz"
    }
)
{
    float usdGen:frizz:amplitude = 0.0 (
        doc = """Displacement amplitude as a fraction of the strand's reference length (restLength when present). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:wavesX = 0.0 (
        doc = """Waves per reference length on the first axis. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:wavesZ = 0.0 (
        doc = """Waves per reference length on the second axis. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:noise = 0.0 (
        doc = """Weight of the value-noise kinks added to the waves, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:noiseSize = 0.1 (
        doc = """Length of one noise kink along the strand (scene units). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:sharpness = 0.0 (
        doc = """0 bends in smooth bumps; 1 in straight runs with sharp corners. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:root = 0.0 (
        doc = """Frizz strength at the root (quadratic Bezier root/mid/tip profile: control points (0, root), (midShift, mid), (1, tip); mid is a control value, midShift its position along the strand). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:mid = 0.5 (
        doc = """Frizz strength middle control value. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:midShift = 0.5 (
        doc = """Position of the frizz mid control along the strand, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:frizz:tip = 1.0 (
        doc = """Frizz strength at the tip. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:frizz:useClumpIds = false (
        doc = """Strands of one clump (clumpId_0) frizz together. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:frizz:preserveKnots = false (
        doc = """Reduces frizz at braid crossings using braidKnotMask. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenTieClump — pulls the strands of tied guides toward the hair-tie points.
class UsdGenTieClump "UsdGenTieClump" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "TieClump"
    }
)
{
    rel usdGen:guides (
        doc = """The guide curves the ties bind to (strands follow primaryGuide)."""
    )
    float usdGen:tie:amount = 1.0 (
        doc = """How strongly strands clump to the ties, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:tie:spread = 0.25 (
        doc = """How far the tie clumping reaches along the strand, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    point3f[] usdGen:tie:positions = [] (
        doc = """Tie positions (scene units). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:tie:entryCounts = [] (
        doc = """Number of (guide, vertex) bindings per tie. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:tie:guideIndices = [] (
        doc = """Guide curve index (in the guide set) of each binding, concatenated over ties. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int[] usdGen:tie:vertexIndices = [] (
        doc = """Guide point index of each binding, concatenated over ties. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenCardSource — grows strands on hair cards: card spines (usdGen:cards)
# are meshed into surface grids and a tile-space strand library
# (usdGen:cardStrands) is mapped onto every card using that tile.
class UsdGenCardSource "UsdGenCardSource" (
    inherits = </UsdGenGenerator>
    customData = {
        string className = "CardSource"
    }
)
{
    rel usdGen:cards (
        doc = """Card spine BasisCurves (one curve per card) carrying the card parameters as primvars:usdGen:plane:* (see the card plane contract)."""
    )
    rel usdGen:cardStrands (
        doc = """Tile-space strand library BasisCurves with uniform primvars:usdGen:plane:uvId and :tile."""
    )
    int usdGen:cardSource:layer = -1 (
        doc = """Grow only on cards of this layer (-1 = all). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:cardSource:uvId = -1 (
        doc = """Grow only on cards with this UV set id (-1 = all). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:cardSource:tile = -1 (
        doc = """Grow only on cards using this tile (-1 = all). Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:cardSource:braid = false (
        doc = """Grow on braid cards instead of ribbon/cross/tube cards. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:cardSource:amount = 1.0 (
        doc = """Share of the tile's strands grown on each card, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:cardSource:rootFlatten = 0.0 (
        doc = """Presses the hair onto the card surface: 0 keeps the tile depth, 1 lays every strand flat. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    bool usdGen:cardSource:smooth = true (
        doc = """Grows on the smoothed (subdivided) cards. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:cvCount = 8 (
        doc = """CVs per generated strand, in [2, 4096]; strands are resampled uniformly in arc length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:cardSource:braidWidth = 1.0 (
        doc = """Braid cards: width of the strand spread around each braid card, relative to the reference length. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:cardSource:braidFlatness = 0.55 (
        doc = """Braid cards: flattens the strand spread across the braid, in [0, 1]. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:cardSource:maxStrands = 2000000 (
        doc = """Upper bound on generated strands; larger libraries are subsampled evenly. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenWind (v3) — 02 §2.8; direction/strength defaults adopted
# (recorded in C1.md §7).
class UsdGenWind "UsdGenWind" (
    inherits = </UsdGenDeformer>
    customData = {
        string className = "Wind"
    }
)
{
    vector3f usdGen:direction = (0, 0, 1) (
        doc = """Authored Wind control "direction". Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:constStrength = 0.0 (
        doc = """Authored Wind control "constStrength". Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:gustStrength = 0.0 (
        doc = """Authored Wind control "gustStrength". Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:stiffness = 0.0 (
        doc = """Authored Wind control "stiffness". Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2[] usdGen:stiffness:knots = [(0, 1), (1, 1)] (
        doc = """(position, value) ramp knots with position in [0, 1] for Wind. Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:stiffness:interpolation = "catmullRom" (
        doc = """Interpolation token for Wind. Declared for the frozen v1-v3 vocabulary; no kernel implements Wind yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
}

# ---------------------------------------------------------------------------
# Chain cap and instancer (02-schema.md §2.9, §2.11)
# ---------------------------------------------------------------------------

# UsdGenFreeze — caps the chain at a snapshot; the unfreeze gesture is the
# one usdGen:frozen:mode token (02 §2.9).
class UsdGenFreeze "UsdGenFreeze" (
    inherits = </UsdGenOperator>
    customData = {
        string className = "Freeze"
    }
)
{
    rel usdGen:frozen:curves (
        doc = """Relationship consumed by Freeze. Declared for the frozen v1-v3 vocabulary; no kernel implements Freeze yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    uniform token usdGen:frozen:mode = "frozen" (
        doc = """Mode token for Freeze. Declared for the frozen v1-v3 vocabulary; no kernel implements Freeze yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["frozen", "live"]
    )
    uniform string usdGen:frozen:epoch = "" (
        doc = """Authored Freeze control "epoch". Declared for the frozen v1-v3 vocabulary; no kernel implements Freeze yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    uniform token usdGen:frozen:tier = "session" (
        doc = """Authored Freeze control "tier". Declared for the frozen v1-v3 vocabulary; no kernel implements Freeze yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["session", "sublayer", "payload"]
    )
}

# UsdGenInstance — the only operator that does not emit curves: a Hydra
# instancer over re-rooted prototypes (02 §2.11; v1, M6).
class UsdGenInstance "UsdGenInstance" (
    inherits = </UsdGenOperator>
    customData = {
        string className = "Instance"
    }
)
{
    uniform token usdGen:primitive = "cards" (
        doc = """Authored Instance control "primitive". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["cards", "archives", "spheres"]
    )
    rel usdGen:prototypes (
        doc = """Relationship consumed by Instance. Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    float[] usdGen:instance:weights = [] (
        doc = """Authored Instance control "weights". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:instance:orient = "surfaceFrame" (
        doc = """Authored Instance control "orient". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["surfaceFrame", "curveTangent", "camera", "world"]
    )
    float usdGen:instance:scale = 1.0 (
        doc = """Scale for Instance. Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float2 usdGen:instance:scaleRandom = (1, 1) (
        doc = """Authored Instance control "scaleRandom". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:instance:twist = 0.0 (
        doc = """Authored Instance control "twist". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:instance:twistRandom = 0.0 (
        doc = """Authored Instance control "twistRandom". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:instance:normalOffset = 0.0 (
        doc = """Authored Instance control "normalOffset". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:instance:width = 0.02 (
        doc = """Authored Instance control "width". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float usdGen:instance:length = 0.09 (
        doc = """Authored Instance control "length". Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float2[] usdGen:instance:width:knots = [(0, 1), (1, 1)] (
        doc = """(position, value) ramp knots with position in [0, 1] for Instance. Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform token usdGen:instance:width:interpolation = "catmullRom" (
        doc = """Interpolation token for Instance. Declared for the frozen v1-v3 vocabulary; no kernel implements Instance yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["linear", "catmullRom", "bspline", "constant"]
    )
    token[] usdGen:instance:variationPrimvars = ["displayColor"] (
