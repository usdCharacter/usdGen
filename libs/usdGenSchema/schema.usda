        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

# UsdGenResample — changes the CV count (topology).
class UsdGenResample "UsdGenResample" (
    inherits = </UsdGenStyler>
    customData = {
        string className = "Resample"
    }
)
{
