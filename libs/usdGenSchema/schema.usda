    float usdGen:noise:lacunarity = 2.0 (
        doc = """Authored NoiseMap control "lacunarity". Declared for the frozen v1-v3 vocabulary; no kernel implements NoiseMap yet (02 §8.2), so this value is never read. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    float usdGen:noise:gain = 0.5 (
        doc = """Authored NoiseMap control "gain". Declared for the frozen v1-v3 vocabulary; no kernel implements NoiseMap yet (02 §8.2), so this value is never read. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    int usdGen:noise:octaves = 3 (
        doc = """Authored NoiseMap control "octaves". Declared for the frozen v1-v3 vocabulary; no kernel implements NoiseMap yet (02 §8.2), so this value is never read. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    uniform int usdGen:noise:seed = 0 (
        doc = """Seed for NoiseMap. Declared for the frozen v1-v3 vocabulary; no kernel implements NoiseMap yet (02 §8.2), so this value is never read. Expression evaluation: point (once per CV)."""
        customData = { dictionary usdGen = { string evaluation = "point" } }
    )
    token usdGen:noise:space = "rest" (
        doc = """Authored NoiseMap control "space". Declared for the frozen v1-v3 vocabulary; no kernel implements NoiseMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["rest", "deformed"]
    )
}

class UsdGenCombineMap "UsdGenCombineMap" (
    inherits = </UsdGenMap>
