    )
    float usdGen:proximity:radius = 1.0 (
        doc = """Radius for GuideProximityMap. Declared for the frozen v1-v3 vocabulary; no kernel implements GuideProximityMap yet (02 §8.2), so this value is never read. Expression evaluation: primitive (once per curve root)."""
