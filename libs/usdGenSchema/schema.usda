# ---------------------------------------------------------------------------
# Maps (02-schema.md §2.12). Not chain nodes: no usdGen:input, readPhase,
# space or enabled.
# ---------------------------------------------------------------------------

class "UsdGenMap" (
    inherits = </Typed>
    customData = {
        string className = "Map"
    }
)
{
    uniform token usdGen:map:domain = "root" (
        doc = """Where the map is sampled: "root" samples once per root, "cv" once per CV. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["root", "cv"]
    )
    uniform token usdGen:map:channel = "r" (
        doc = """Which channel of the map supplies the scalar: "r", "g", "b" or "a". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["r", "g", "b", "a", "rgb", "luminance"]
    )
    float usdGen:map:scale = 1.0 (
        doc = """Multiplier applied to the sampled value before usdGen:map:offset. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float usdGen:map:offset = 0.0 (
        doc = """Constant added to the scaled sample. Expression evaluation: primitive (once per curve root)."""
        customData = { dictionary usdGen = { string evaluation = "primitive" } }
    )
    float2 usdGen:map:clamp = (0, 1) (
        doc = """Output interval the final sample is clamped to. Equal components disable the clamp. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    float usdGen:map:default = 0.0 (
        doc = """Value substituted wherever the map cannot be sampled. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
}

class UsdGenImageMap "UsdGenImageMap" (
    inherits = </UsdGenMap>
    customData = {
        string className = "ImageMap"
    }
)
{
    asset usdGen:map:file (
        doc = """Asset path of the texture this map samples. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:map:uvSet = "st" (
        doc = """Name of the UV set used to sample the texture. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:map:wrap = "clamp" (
        doc = """Out-of-range UV behaviour: "black", "clamp", "repeat" or "mirror". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["clamp", "repeat", "mirror", "black"]
    )
    token usdGen:map:filter = "bilinear" (
        doc = """Texture filter: "nearest" or "bilinear". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["nearest", "bilinear"]
    )
    token usdGen:map:colorSpace = "raw" (
        doc = """Colour space of the texture: "raw" or "sRGB". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["auto", "raw", "sRGB"]
    )
}

class UsdGenPtexMap "UsdGenPtexMap" (
    inherits = </UsdGenMap>
    customData = {
        string className = "PtexMap"
    }
)
{
    asset usdGen:map:file (
        doc = """Asset path of the texture this map samples. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:map:filter = "bilinear" (
        doc = """Texture filter: "nearest" or "bilinear". Expression evaluation: groom (once per operator)."""
        allowedTokens = ["nearest", "bilinear", "box", "gaussian", "bicubic",
                         "bspline", "catmullrom", "mitchell"]
    )
    float usdGen:map:blur = 0.0 (
        doc = """Ptex filter blur radius. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    int usdGen:map:firstChannel = 0 (
        doc = """First Ptex channel read by this map. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    uniform uint64 usdGen:map:textureGeneration = 0 (
        doc = """Immutable authored Ptex content generation. Runtime compares this value with a CurveSource expected map generation; ReloadMaps cache generations remain separate."""
    )
    int usdGen:map:channelCount = 1 (
        doc = """Number of Ptex channels read by this map. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    token usdGen:map:borderMode = "clamp" (
        doc = """Ptex border behaviour at mesh edges. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["clamp", "black", "periodic"]
    )
}

class UsdGenExprMap "UsdGenExprMap" (
    inherits = </UsdGenMap>
    customData = {
        string className = "ExprMap"
    }
)
{
    string usdGen:expr:source = "" (
        doc = """Authored ExprMap control "source". Declared for the frozen v1-v3 vocabulary; no kernel implements ExprMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    uniform token usdGen:expr:returnType = "float" (
        doc = """Authored ExprMap control "returnType". Declared for the frozen v1-v3 vocabulary; no kernel implements ExprMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["float", "color"]
    )
    uniform int usdGen:expr:seed = 0 (
        doc = """Seed for ExprMap. Declared for the frozen v1-v3 vocabulary; no kernel implements ExprMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    rel usdGen:expr:maps (
        doc = """Relationship consumed by ExprMap. Declared for the frozen v1-v3 vocabulary; no kernel implements ExprMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
}

class UsdGenPaintMap "UsdGenPaintMap" (
    inherits = </UsdGenMap>
    customData = {
        string className = "PaintMap"
    }
)
{
    rel usdGen:paint:surface (
        doc = """The Mesh whose faceVarying usdGen:paint:primvar this map reads, or a face GeomSubset of it. Exactly one target. A GeomSubset still reads the primvar from its parent Mesh, and the corners of faces outside the subset read usdGen:map:default. Strands sample it by their root face, so it must be the mesh of the description's usdGen:surface (a subset of that mesh included). Expression evaluation: groom (once per operator)."""
    )
    token usdGen:paint:primvar = "usdGen:paint:density" (
        doc = """Authored PaintMap control "primvar". Declared for the frozen v1-v3 vocabulary; no kernel implements PaintMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:paint:interpolation = "faceVarying" (
        doc = """Interpolation token for PaintMap. Declared for the frozen v1-v3 vocabulary; no kernel implements PaintMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
    token usdGen:paint:storage = "primvar" (
        doc = """Authored PaintMap control "storage". Declared for the frozen v1-v3 vocabulary; no kernel implements PaintMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        allowedTokens = ["primvar", "file"]
    )
    int usdGen:paint:resolution = 256 (
        doc = """Authored PaintMap control "resolution". Declared for the frozen v1-v3 vocabulary; no kernel implements PaintMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
        customData = { dictionary usdGen = { string evaluation = "groom" } }
    )
    asset usdGen:paint:bakedFile (
        doc = """Authored PaintMap control "bakedFile". Declared for the frozen v1-v3 vocabulary; no kernel implements PaintMap yet (02 §8.2), so this value is never read. Expression evaluation: groom (once per operator)."""
    )
}

class UsdGenNoiseMap "UsdGenNoiseMap" (
    inherits = </UsdGenMap>
