--- --------------------------------------------------------------------------
-- glsl UsdGenStrands.Marschner

#if defined(USDGEN_STRANDS_MODEL_MARSCHNER)

// The model's defaults, used where the matching control is left unauthored
// (negative), and the point its scattering table is built at.
#define USDGEN_MARSCHNER_SHIFT      0.03   // cuticle shift s, radians
#define USDGEN_MARSCHNER_AZIMUTHAL  0.35
// Chiang's colour <-> absorption constant at azimuthal roughness 0.3:
// 5.969 - 0.215 b + 2.532 b^2 - 10.73 b^3 + 5.574 b^4 + 0.245 b^5.
#define USDGEN_MARSCHNER_CHIANG_D   5.8884148

struct UsdGenMarschnerLobes
{
    float B0;           // R   width, sum-of-sines standard deviation
    float B1;           // TT  width
    float B2;           // TRT width
    float tableRough;   // scattering-table roughness, clamp(v, 0.18, 0.6)
    float azimuthal;    // azimuthal roughness, >= 0.02
    float shift;        // s: R at -s, TT at s/2, TRT at 1.5 s
    float ior;
    float f0;
    float specular;     // R gain
    float ttScale;      // TT gain
    float backScatter;  // gain on the dual-scattering back-scatter lobe
};

// The shared inputs, read the way this model defines them:
//   roughness              both lobes when the split controls are unauthored:
//                          B_R = r^2 and v = r^2, i.e. the Karis widths
//   primaryRoughness p     B_R = clamp(p^2, 1/255, 1), so an imported
//                          Roughness R at variance v is p = sqrt(2 v R)
//   longitudinalRoughness l  v = l^2: B_TT = v/2, B_TRT = 2v; the imported
//                          longitudinal roughness beta_m gives
//                          v = (0.726 b + 0.812 b^2 + 3.7 b^20)^2
//   azimuthalRoughness     >= 0.02; negative keeps 0.35
//   cuticleTilt (degrees)  s = 4 * radians(cuticleTilt): the R shift equals
//                          the Karis model's for the same input; negative
//                          keeps s = 0.03 rad
//   specular               R x 2*specular (0.5 = 1, as in the Karis model)
//   backlit                TT gain
//   ior                    Fresnel F0 and the Bravais index
// randomRoughness jitters every width by one per-strand factor.
UsdGenMarschnerLobes UsdGenMarschnerMaterialLobes(float seed)
{
    float jitter =
        max(0.0, 1.0 + (fract(seed * 29.0) - 0.5) * 2.0 * HdGet_randomRoughness());
    float r = clamp(HdGet_roughness() * jitter, 1.0 / 255.0, 1.0);
    float p = HdGet_primaryRoughness();
    p = p >= 0.0 ? clamp(p * jitter, 1.0 / 255.0, 1.0) : r;
    float l = HdGet_longitudinalRoughness();
    l = l >= 0.0 ? clamp(l * jitter, 1.0 / 255.0, USDGEN_STRANDS_MAX_LONGITUDINAL)
                 : r;
    float v = l * l;

    UsdGenMarschnerLobes lobes;
    lobes.B0 = clamp(p * p, 1.0 / 255.0, 1.0);
    lobes.B1 = max(0.001, v * 0.5);
    lobes.B2 = max(0.001, v * 2.0);
    lobes.tableRough = clamp(v, 0.18, 0.6);

    float azimuthal = HdGet_azimuthalRoughness();
    lobes.azimuthal = max(azimuthal >= 0.0 ? azimuthal : USDGEN_MARSCHNER_AZIMUTHAL,
                          0.02);
    float tilt = HdGet_cuticleTilt();
    lobes.shift = tilt >= 0.0 ? 4.0 * radians(tilt) : USDGEN_MARSCHNER_SHIFT;

    lobes.ior = max(HdGet_ior(), 1.0);
    lobes.f0 = UsdGenStrandsPow2((1.0 - lobes.ior) / (1.0 + lobes.ior));
    lobes.specular = max(HdGet_specular(), 0.0) * 2.0;
    lobes.ttScale = max(HdGet_backlit(), 0.0);
    lobes.backScatter = max(HdGet_backScatter(), 0.0);
    return lobes;
}

// Chiang 2016's colour -> absorption at azimuthal roughness 0.3.
vec3 UsdGenMarschnerAbsorption(vec3 albedo)
{
    vec3 l = log(max(clamp(albedo, vec3(0.0), vec3(1.0)), vec3(1e-6))) /
             USDGEN_MARSCHNER_CHIANG_D;
    return l * l;
}

struct UsdGenMarschnerGeometry
{
    float sinThetaL;
    float sinThetaV;
    float cosThetaD;
    float cosPhi;
    float cosHalfPhi;
    float VoL;
};

// `T` runs root -> tip here: the model's tangent, the opposite of the Karis
// path's (which points at the root, as HairBsdf.ush wants it).
UsdGenMarschnerGeometry UsdGenMarschnerGeometryOf(vec3 T, vec3 L, vec3 V)
{
    UsdGenMarschnerGeometry g;
    g.VoL = dot(V, L);
    g.sinThetaL = clamp(dot(T, L), -1.0, 1.0);
    g.sinThetaV = clamp(dot(T, V), -1.0, 1.0);
    // cos((theta_V - theta_L) / 2) without the two asin().
    float cV = sqrt(clamp(1.0 - g.sinThetaV * g.sinThetaV, 0.0, 1.0));
    float cL = sqrt(clamp(1.0 - g.sinThetaL * g.sinThetaL, 0.0, 1.0));
    g.cosThetaD = sqrt(max(0.0, 0.5 + 0.5 * (cV * cL + g.sinThetaV * g.sinThetaL)));
    vec3 Lp = L - g.sinThetaL * T;
    vec3 Vp = V - g.sinThetaV * T;
    g.cosPhi = dot(Lp, Vp) * inversesqrt(dot(Lp, Lp) * dot(Vp, Vp) + 1e-4);
    g.cosHalfPhi = sqrt(clamp(0.5 + 0.5 * g.cosPhi, 0.0, 1.0));
    return g;
}

float UsdGenMarschnerMp(float B, float theta)
{
    float invB = 1.0 / max(B, 1e-5);
    return exp(-0.5 * UsdGenStrandsPow2(theta * invB)) * 0.39894228 * invB;
}

float UsdGenMarschnerF(float f0, float cosTheta)
{
    return f0 + (1.0 - f0) * UsdGenStrandsPow5(1.0 - cosTheta);
}

// The TT azimuthal term. The model samples a 64 x 64 two-channel table with
// bilinear filtering and clamp at u = 0.5 - 0.5 sin(theta_L),
// v = sqrt(azimuthalRoughness), and its rows and columns are closed-form:
//   R(row y)    = 1 / (max(0.05, 2 (y/63)^2) sqrt(2 PI))
//   G(column x) = 0.5 - x/63
//   Np_TT       = R exp(-(cos(phi) + G)^2)
// G is linear in x, so the filtered G is exact; R is interpolated between its
// two rows as the texture unit does. The lobe is centred at
// cos(phi) = -G ~ -0.51 sin(theta_L) and is broad: this is the model's
// function as it ships, kept as is.
float UsdGenMarschnerTtAzimuthal(float cosPhi, float sinThetaL, float azimuthal)
{
    float x = clamp(64.0 * (0.5 - 0.5 * sinThetaL) - 0.5, 0.0, 63.0);
    float G = 0.5 - x / 63.0;
    float y = clamp(64.0 * sqrt(azimuthal) - 0.5, 0.0, 63.0);
    float y0 = floor(y);
    float y1 = min(y0 + 1.0, 63.0);
    float r0 = 1.0 / (max(0.05, 2.0 * UsdGenStrandsPow2(y0 / 63.0)) * 2.5066311);
    float r1 = 1.0 / (max(0.05, 2.0 * UsdGenStrandsPow2(y1 / 63.0)) * 2.5066311);
    float d = cosPhi + G;
    return mix(r0, r1, y - y0) * exp(-d * d);
}

// The single-scattering BSDF. `area` widens the three lobes by the strand's
// pixel footprint, as on the Karis path; it is 0 for a resolved strand.
vec3 UsdGenMarschnerShading(UsdGenMarschnerGeometry g, vec3 sigma,
                            UsdGenMarschnerLobes lobes, float area)
{
    float cosThetaD = max(g.cosThetaD, 1e-4);
    float thetaH = g.sinThetaL + g.sinThetaV;
    // Bravais' index for the inclined fibre cross-section.
    float iorp = sqrt(lobes.ior * lobes.ior - (1.0 - cosThetaD * cosThetaD)) /
                 cosThetaD;
    float s = lobes.shift;
    vec3 S = vec3(0.0);

    // ---- R: white primary highlight.
    {
        float Mp = UsdGenMarschnerMp(lobes.B0 + area, thetaH + s);
        float Fp = UsdGenMarschnerF(lobes.f0,
                                    sqrt(clamp(0.5 + 0.5 * g.VoL, 0.0, 1.0)));
        S += vec3(Fp * Mp * 0.25 * g.cosHalfPhi * lobes.specular);
    }

    // ---- TT: transmission, the coloured rim.
    {
        float Mp = UsdGenMarschnerMp(lobes.B1 + area, thetaH - 0.5 * s);
        float a = 1.0 / iorp;
        float m = 1.0 - g.cosHalfPhi;
        float m2 = m * m;
        float h = (1.0 - m) * (1.0 - 0.5 * m2 + a * m + a * m2 - 0.15 * a);
        float x = clamp(h / iorp, -1.0, 1.0);
        // 1 + cos(2 asin x) = 2 - 2 x^2.
        vec3 Tp = exp(-2.0 * sigma * (2.0 - 2.0 * x * x));
        float f = UsdGenMarschnerF(lobes.f0,
                                   cosThetaD * sqrt(clamp(1.0 - h * h, 0.0, 1.0)));
        float Np = UsdGenMarschnerTtAzimuthal(g.cosPhi, g.sinThetaL,
                                              lobes.azimuthal);
        S += Mp * Np * UsdGenStrandsPow2(1.0 - f) * Tp * lobes.ttScale;
    }

    // ---- TRT: the coloured secondary highlight, at h = sqrt(3)/2.
    {
        float Mp = UsdGenMarschnerMp(lobes.B2 + area, thetaH - 1.5 * s);
        float f = UsdGenMarschnerF(lobes.f0, cosThetaD * 0.5);
        float x = clamp(0.866025404 / iorp, -1.0, 1.0);
        vec3 Tr = exp(-2.0 * sigma * (2.0 - 2.0 * x * x));
        float sr = clamp(1.5 * (1.0 - lobes.azimuthal), 0.0, 1.0);
        float Np = sr * exp(sr * (17.0 * g.cosPhi - 16.78));
        S += Mp * Np * UsdGenStrandsPow2(1.0 - f) * f * Tr * Tr;
    }
    return max(S, vec3(0.0));
}

// ---------------------------------------------------------------------------
// Scattering table lookup: trilinear in (incidence angle, roughness,
// absorption coordinate) for a_f / a_b, bilinear in (angle, absorption) for
// the TT column, linear in angle for the R column. The absorption coordinate
// is sigma itself, clamped to the texel centres, while the table was built at
// sigma = coordinate^2: the model's own indexing, kept (it brightens multiple
// scattering in dark hair).
struct UsdGenMarschnerAverages
{
    vec3  af;
    vec3  ab;
    vec3  ntt;
    float nr;
};

UsdGenMarschnerAverages UsdGenMarschnerTableLookup(float sinTheta,
                                                   float roughness, vec3 sigma)
{
    const int NT = USDGEN_MARSCHNER_DS_NT;
    const int NR = USDGEN_MARSCHNER_DS_NR;
    const int NA = USDGEN_MARSCHNER_DS_NA;

    float th = asin(clamp(sinTheta, 1.0 / 64.0, 63.0 / 64.0));
    float ft = (th - USDGEN_MARSCHNER_DS_TH0) /
               (USDGEN_MARSCHNER_DS_TH1 - USDGEN_MARSCHNER_DS_TH0) * float(NT - 1);
    int t0 = clamp(int(ft), 0, NT - 2);
    float wt = clamp(ft - float(t0), 0.0, 1.0);
    float fr = (clamp(roughness, 0.18, 0.6) - 0.18) / 0.42 * float(NR - 1);
    int r0 = clamp(int(fr), 0, NR - 2);
    float wr = clamp(fr - float(r0), 0.0, 1.0);

    UsdGenMarschnerAverages out_;
    out_.nr = mix(UsdGenMarschnerDsNr[t0], UsdGenMarschnerDsNr[t0 + 1], wt);
    for (int c = 0; c < 3; ++c) {
        float fa = clamp(sigma[c] * float(NA) - 0.5, 0.0, float(NA - 1));
        int a0 = clamp(int(fa), 0, NA - 2);
        float wa = clamp(fa - float(a0), 0.0, 1.0);
        vec2 v = vec2(0.0);
        float ntt = 0.0;
        for (int dt = 0; dt < 2; ++dt) {
            float w1 = dt == 0 ? 1.0 - wt : wt;
            for (int da = 0; da < 2; ++da) {
                float w3 = da == 0 ? 1.0 - wa : wa;
                ntt += w1 * w3 * UsdGenMarschnerDsNtt[(t0 + dt) * NA + a0 + da];
                for (int dr = 0; dr < 2; ++dr) {
                    float w2 = dr == 0 ? 1.0 - wr : wr;
                    int i = (((t0 + dt) * NR) + r0 + dr) * NA + a0 + da;
                    v += (w1 * w2 * w3) *
                         vec2(UsdGenMarschnerDsAfAb[2 * i],
                              UsdGenMarschnerDsAfAb[2 * i + 1]);
                }
            }
        }
        out_.af[c] = v.x;
        out_.ab[c] = v.y;
        out_.ntt[c] = ntt;
    }
    return out_;
}

// Normalised Gaussian in a variance.
float UsdGenMarschnerGauss(float variance, float x)
{
    variance = max(variance, 1.0e-4);
    return exp(-x * x / (2.0 * variance)) /
           sqrt(max(2.0 * USDGEN_STRANDS_PI * variance, 1.0e-6));
}

// Zinke & Yuksel 2008 dual scattering as the model composes it. `n` is the
// hair count toward the light. Its expressions are kept as they ship,
// including where they mix units: the per-channel a_f weights blend the three
// lobes' shifts and widths, and a lobe width (a standard deviation) is added
// to the forward variance in the forward-scatter Gaussians.
vec3 UsdGenMarschnerDualScattering(vec3 bsdf, float n, UsdGenMarschnerLobes lobes,
                                   UsdGenMarschnerGeometry g, vec3 sigma)
{
    UsdGenMarschnerAverages avg =
        UsdGenMarschnerTableLookup(abs(g.sinThetaL), lobes.tableRough, sigma);

    float alphaR = -lobes.shift;
    float alphaTT = 0.5 * lobes.shift;
    float alphaTRT = 1.5 * lobes.shift;
    float thetaH = g.sinThetaL + g.sinThetaV;
    float cosThetaD = max(g.cosThetaD, 1.0e-4);
    float cosThetaL = sqrt(clamp(1.0 - g.sinThetaL * g.sinThetaL, 0.0, 1.0));
    const float df = 0.7;
    const float db = 0.7;
    float piCosD = USDGEN_STRANDS_PI * cosThetaD;

    vec3 af = min(vec3(0.99), avg.af);
    vec3 af2 = af * af;
    vec3 oneMinusAf2 = vec3(1.0) - af2;
    vec3 oneMinusAf2Sq = oneMinusAf2 * oneMinusAf2;
    vec3 oneMinusAf2Cu = oneMinusAf2Sq * oneMinusAf2;
    vec3 ab = min(vec3(0.99), avg.ab);
    vec3 ab2 = ab * ab;
    vec3 ab3 = ab2 * ab;

    vec3 afWeights = af / max(af.r + af.g + af.b, 1.0e-4);
    float alphaF = dot(vec3(alphaR, alphaTT, alphaTRT), afWeights);
    float alphaB = alphaF;
    float betaF = dot(vec3(lobes.B0, lobes.B1, lobes.B2), afWeights);
    float betaF2 = betaF * betaF;
    vec3 abWeights = ab / max(ab.r + ab.g + ab.b, 1.0e-4);
    float betaB = dot(vec3(lobes.B0, lobes.B1, lobes.B2), abWeights);
    float betaB2 = betaB * betaB;

    // Forward scattering through n fibres.
    float sigmaF2 = betaF2 * max(1.0, n);
    float Sf = UsdGenMarschnerGauss(sigmaF2, thetaH) / piCosD;
    vec3 Tf = df * pow(max(avg.af, vec3(1.0e-6)), vec3(n)) * Sf;
    float fs = UsdGenMarschnerGauss(lobes.B0 + sigmaF2, thetaH - alphaR) * avg.nr;
    vec3 fsScatter = vec3(fs) +
        UsdGenMarschnerGauss(lobes.B1 + sigmaF2, thetaH - alphaTT) * avg.ntt;

    // Back scattering.
    vec3 Ab = ab * af2 / max(oneMinusAf2, vec3(1.0e-4))
            + ab3 * af2 / max(oneMinusAf2Cu, vec3(1.0e-4));
    vec3 deltaB = alphaB * (vec3(1.0) - 2.0 * ab2 / max(oneMinusAf2Sq, vec3(1.0e-4)))
                + alphaF * ((2.0 * oneMinusAf2Sq + 4.0 * af2 * ab2) /
                            max(oneMinusAf2Cu, vec3(1.0e-4)));
    vec3 sigmaB = (vec3(1.0) + db * af2) *
        (ab * sqrt(max(2.0 * betaF2 + betaB2, 1.0e-4)) +
         ab3 * sqrt(max(2.0 * betaF2 + 3.0 * betaB2, 1.0e-4))) /
        max(ab + ab3 * (2.0 * betaF + 3.0 * betaB), vec3(1.0e-4));
    vec3 sigmaB2 = sigmaB * sigmaB;
    vec3 SbDirect = vec3(UsdGenMarschnerGauss(sigmaB2.r, thetaH - deltaB.r),
                         UsdGenMarschnerGauss(sigmaB2.g, thetaH - deltaB.g),
                         UsdGenMarschnerGauss(sigmaB2.b, thetaH - deltaB.b)) / piCosD;
    vec3 SbScatter = vec3(
        UsdGenMarschnerGauss(sigmaF2 + sigmaB2.r, thetaH - deltaB.r),
        UsdGenMarschnerGauss(sigmaF2 + sigmaB2.g, thetaH - deltaB.g),
        UsdGenMarschnerGauss(sigmaF2 + sigmaB2.b, thetaH - deltaB.b)) / piCosD;
    vec3 fBackDirect = 2.0 * Ab * SbDirect / cosThetaD * lobes.backScatter;
    vec3 fBackScatter = 2.0 * Ab * SbScatter / cosThetaD * lobes.backScatter;

    float direct = exp(-n);
    vec3 Fdirect = direct * (bsdf + db * fBackDirect);
    vec3 Fscatter = clamp(Tf - vec3(direct), vec3(0.0), vec3(1.0)) * df *
                    (fsScatter + USDGEN_STRANDS_PI * db * fBackScatter);
    return (Fscatter + Fdirect) * cosThetaL;
}

// Without dual scattering (selfShadow 0, or no density bake) the model adds a
// colourised wrap term in place of multiple scattering, and a weak albedo
// back-scatter fill.
vec3 UsdGenMarschnerFallback(vec3 S, vec3 T, vec3 L, vec3 V, vec3 albedo,
                             float fake, float backScatter)
{
    vec3 result = S;
    if (fake > 0.0) {
        vec3 nFake = UsdGenStrandsSafeNormalize(V - T * dot(T, V), V);
        float maxAlbedo = max(albedo.r, max(albedo.g, albedo.b));
        vec3 normalized = maxAlbedo > 1.0e-5 ? albedo / maxAlbedo : vec3(0.0);
        result += sqrt(max(albedo, vec3(0.0))) * normalized *
                  (dot(L, nFake) + 1.0) * fake;
    }
    result += albedo * backScatter * (0.5 - 0.5 * dot(V, L)) * 0.05;
    return result;
}

// Mean sky radiance: the six axis lookups of the cosine-convolved dome cover
// the sphere evenly and return L for a uniform sky.
vec3 UsdGenMarschnerSkyMean()
{
#ifdef HD_HAS_domeLightIrradiance
    return (HdGet_domeLightIrradiance(vec3( 1.0, 0.0, 0.0)).rgb +
            HdGet_domeLightIrradiance(vec3(-1.0, 0.0, 0.0)).rgb +
            HdGet_domeLightIrradiance(vec3(0.0,  1.0, 0.0)).rgb +
            HdGet_domeLightIrradiance(vec3(0.0, -1.0, 0.0)).rgb +
            HdGet_domeLightIrradiance(vec3(0.0, 0.0,  1.0)).rgb +
            HdGet_domeLightIrradiance(vec3(0.0, 0.0, -1.0)).rgb) * (1.0 / 6.0);
#else
    return vec3(1.0);
#endif
}

// Hair ambient occlusion from the local hair density the bake publishes as
// `furDensity` (crossings per voxel, hair only). Scaled by selfShadow like
// the hair count, so one setting maps both onto the source's density units.
float UsdGenMarschnerHairOcclusion(float selfShadow)
{
#if defined(HD_HAS_furDensity)
    float k = max(HdGet_aoIntensity(), 0.0) * selfShadow;
    return k > 0.0 ? exp(-k * max(HdGet_furDensity(), 0.0)) : 1.0;
#else
    return 1.0;
#endif
}

// All lights. `T` is the shader's tangent (toward the root); `area` the
// pixel-footprint variance.
vec3 UsdGenMarschnerLighting(vec4 Peye, vec3 P, vec3 V, vec3 T, float t,
                             float seed, vec3 albedo, float area)
{
    vec3 Ts = -T;
    UsdGenMarschnerLobes lobes = UsdGenMarschnerMaterialLobes(seed);
    vec3 sigma = UsdGenMarschnerAbsorption(albedo);
    float selfShadow = max(HdGet_selfShadow(), 0.0);
    float fake = max(HdGet_scatter(), 0.0);
    vec3 tauP = UsdGenStrandsTauPositive(t);
    vec3 tauN = UsdGenStrandsTauNegative(t);
    bool dual = false;
    float visibility = 1.0;
#if defined(USDGEN_STRANDS_HAS_DENSITY)
    dual = selfShadow > 0.0;
#else
    // No density bake: the legacy hairT canopy, as on the Karis path.
    visibility = mix(1.0, smoothstep(0.0, 1.0, t), clamp(selfShadow * 0.5, 0.0, 1.0));
#endif
    // The ambient is the model's whole sky term, so both sky gains feed it.
    float ambientGain = max(HdGet_indirectMultiplier(), 0.0) +
                        max(HdGet_ambientFill(), 0.0);

    vec3 result = vec3(0.0);
#if NUM_LIGHTS > 0
    for (int i = 0; i < GetLightCount(); ++i) {
        LightSource light = GetLightSource(i);
        if (light.isIndirectLight) {
            if (ambientGain > 0.0) {
                result += albedo * UsdGenMarschnerSkyMean() * light.diffuse.rgb *
                          ambientGain * UsdGenMarschnerHairOcclusion(selfShadow);
            }
            continue;
        }
        vec3 L = UsdGenStrandsSafeNormalize(
            light.position.xyz - P * light.position.w, vec3(0.0, 1.0, 0.0));
        float attenuation = lightDistanceAttenuation(Peye, i) *
                            lightSpotAttenuation(L, i);
        float sceneShadow = 1.0;
#if USE_SHADOWS
        if (light.hasShadow) sceneShadow = shadowing(i, Peye);
#endif
        UsdGenMarschnerGeometry g = UsdGenMarschnerGeometryOf(Ts, L, V);
        vec3 S = UsdGenMarschnerShading(g, sigma, lobes, area);
        vec3 lit;
        if (dual) {
            // The bake counts the receiver's own half voxel: shift by one.
            float n = max(0.0, UsdGenStrandsHairCount(L, tauP, tauN, selfShadow) - 1.0);
            lit = UsdGenMarschnerDualScattering(S, n, lobes, g, sigma);
        } else {
            lit = UsdGenMarschnerFallback(S, Ts, L, V, albedo, fake,
                                          lobes.backScatter) * visibility;
        }
        result += lit * light.diffuse.rgb * attenuation * sceneShadow;
    }
#endif
    return result;
}

#endif // USDGEN_STRANDS_MODEL_MARSCHNER
