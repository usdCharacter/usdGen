    )
    float inputs:usePresetColors = 0 (
        doc = "Blend (0..1) from the root/tip/melanin albedo to the per-strand preset gradient A/B/C picked by hairId."
    )
    float inputs:presetSrgb = 0 (
        doc = "1: preset stops are sRGB-encoded, blended as authored and linearised after; 0: linear."
    )
    color3f inputs:presetColorA1 = (0.035, 0.018, 0.008) (
        doc = "Preset gradient A, root-side stop."
