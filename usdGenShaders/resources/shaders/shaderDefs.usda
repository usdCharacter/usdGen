#usda 1.0
#
# usdGen hair preview shader definitions (contract C5: docs/freezes/C5.md).
#
# One Shader prim per shipped glslfx file: the three C5-frozen hair looks, then
# the value preview, then the two UE-parity strand looks (neither of the last
# three is part of the C5 freeze; see the end of the file). The Sdr identifier IS the
# prim name (pxr/usd/usdShade/shaderDefUtils.cpp:51-52) — UpperCamel, no
# underscores (SdrFsHelpersSplitShaderIdentifier tokenises on '_'). Only the
# FILE names are lowerCamel. The glslfx files are siblings of this layer, so
# the relative @./...@ citations resolve in the shipped resource dir.
#
# The inputs:* block below is C5-frozen (07-look-maps-expressions.md §2.2):
# 20 parameters + 1 texture, same defaults in all three defs.
# Each def also declares its glslfx `attributes` as node primvar metadata
# (sdrMetadata primvars): hairLook.usda binds by info:id, never an asset path,
# and HdSt requests exactly the Sdr node's GetPrimvars() from the mesh
# (pxr/imaging/hdSt/materialNetwork.cpp:1136). Without it, hairT/hairId/st are
# never bound on usdGen tiles and variant B can never read an authored
# hairTangent (M-12). Values mirror each file's attributes block (C5.md table);
# parsing a glslfx directly surfaces the same list.

def Shader "UsdGenHairPreview" (
    doc = "usdGen hair preview, variant A (tangent from inData.Neye); opaque + alpha-to-coverage. M1 default (PW-2/S-8)."
    sdrMetadata = { string primvars = "hairId|hairT|st|furTauP|furTauN|furTipTauP|furTipTauN" }
)
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:glslfx:sourceAsset = @./usdGenHairPreview.glslfx@
    color3f inputs:rootColor = (0.035, 0.018, 0.008)
    color3f inputs:tipColor = (0.21, 0.115, 0.045)
    float inputs:colorRamp = 1
    float inputs:diffuseGain = 0.55
    float inputs:diffuseWrap = 0.35
    float inputs:specular1Gain = 0.09
    color3f inputs:specular1Color = (1, 1, 1)
    float inputs:specular1Width = 0.12
    float inputs:specular1Shift = -0.045
    float inputs:specular2Gain = 0.05
    color3f inputs:specular2Color = (1, 1, 1)
    float inputs:specular2Width = 0.3
    float inputs:specular2Shift = 0.09
    float inputs:transmissionGain = 0.25
    color3f inputs:transmissionColor = (1, 0.62, 0.38)
    float inputs:opacity = 1
    float inputs:widthFalloff = 0
    float inputs:randomHue = 0
    float inputs:randomValue = 0
    float inputs:selfOcclusion = 0.5
    color3f inputs:rootColorMap = (1, 1, 1)
    token outputs:surface (
        sdrMetadata = { string renderType = "terminal surface" }
    )
}

