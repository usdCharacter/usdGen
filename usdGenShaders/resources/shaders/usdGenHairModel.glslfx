//
// usdGenHairModel.glslfx
//
// Selects the strand model UsdGenHairStrands / UsdGenHairStrandsTranslucent
// compile. The build writes its own copy of this file into the plugin's
// shaders/ directory from the CMake cache variable USDGEN_HAIR_SHADING_MODEL:
//
//   karis      Karis R/TT/TRT with the matching controls
//              (usdGenHairStrandsBsdf.glslfx). The default.
//   marschner  the absorption-based Marschner model imported grooms were
//              shaded with (usdGenHairStrandsMarschner.glslfx).
//
// This source copy selects the default, so the shader directory of a source
// checkout still parses on its own. Exactly one USDGEN_STRANDS_MODEL_* line;
// CMake rewrites it.
//

--- --------------------------------------------------------------------------
-- glsl UsdGenStrands.Model

#define USDGEN_STRANDS_MODEL_KARIS 1
